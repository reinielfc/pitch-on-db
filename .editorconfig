root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.go]
indent_style = tab
indent_size = 4

[*.{js,ts,svelte,css}]
indent_style = tab
indent_size = 4

[*.{html,xml}]
indent_style = tab
indent_size = 2

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2
